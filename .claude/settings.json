{
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run format:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run test:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(pytest:*)",
      "Bash(docker-compose -f docker-compose.development.yml logs:*)",
      "Bash(docker-compose -f docker-compose.development.yml ps:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npx prettier:*)",
      "Bash(pip list:*)",
      "Bash(which:*)",
      "Bash(jq:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-save.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "obsidian-memory@goodwiins-plugins": false,
    "langsmith-tracing@langsmith-claude-code-plugins": true
  },
  "agents": {
    "review-orchestrator": {
      "enabled": true
    },
    "issue-creator": {
      "enabled": true
    },
    "coderabbit-auto-fixer": {
      "enabled": true
    }
  },
  "memory": {
    "enabled": true,
    "path": ".serena/memories"
  }
}
