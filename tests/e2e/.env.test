# Test Environment Configuration
NODE_ENV=test
CI=false

# Base URLs
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
WS_URL=ws://localhost:8000

# Test Database Configuration
TEST_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/rag_test_db
NEO4J_TEST_URI=bolt://localhost:7687
NEO4J_TEST_USER=neo4j
NEO4J_TEST_PASSWORD=test_password
QDRANT_TEST_URL=http://localhost:6333

# Authentication Configuration
JWT_TEST_SECRET=test_jwt_secret_key_change_in_production
JWT_TEST_EXPIRES_IN=1h

# Test User Credentials
TEST_ADMIN_EMAIL=admin@multimodal-rag.com
TEST_ADMIN_PASSWORD=admin123
TEST_USER_EMAIL=user@test.com
TEST_USER_PASSWORD=user123456
TEST_ORG_ADMIN_EMAIL=orgadmin@test.com
TEST_ORG_ADMIN_PASSWORD=orgadmin123456

# Test Organization Data
TEST_ORG_ID=test-org-123
TEST_ORG_NAME=Test Organization
TEST_ORG_SLUG=test-org

# Multi-tenant Test Configuration
TEST_ORG_2_ID=test-org-456
TEST_ORG_2_NAME=Second Test Organization
TEST_ORG_2_SLUG=test-org-2

# Test File Upload Configuration
TEST_UPLOAD_DIR=./test-uploads
TEST_MAX_FILE_SIZE=50MB
TEST_ALLOWED_FILE_TYPES=pdf,txt,jpg,jpeg,png,mp3,mp4,mov,avi,wav

# Performance Test Configuration
PERFORMANCE_TEST_TIMEOUT=120000
PERFORMANCE_WARMUP_REQUESTS=3
PERFORMANCE_METRICS_COLLECTION=true

# Visual Regression Configuration
UPDATE_SNAPSHOTS=false
VISUAL_TEST_THRESHOLD=0.2
VISUAL_IGNORE_ELEMENTS=dynamic-timestamp,user-avatar,notification-badge

# Accessibility Test Configuration
A11Y_TEST_TIMEOUT=30000
A11Y_TEST_LEVEL=WCAG2AA
A11Y_IGNORE_RULES=color-contrast,best-practice

# Mobile Test Configuration
MOBILE_VIEWPORT_WIDTH=375
MOBILE_VIEWPORT_HEIGHT=667
TABLET_VIEWPORT_WIDTH=768
TABLET_VIEWPORT_HEIGHT=1024

# Network Test Configuration
NETWORK_SLOW_3G_DOWNLOAD=500
NETWORK_SLOW_3G_UPLOAD=500
NETWORK_SLOW_3G_LATENCY=400
NETWORK_OFFLINE=false

# Test Data Configuration
TEST_DATA_SEED_FILE=./tests/fixtures/test-data.json
TEST_DATA_CLEANUP=true

# Reporting Configuration
HTML_REPORT_DIR=./test-results/html-report
JSON_REPORT_DIR=./test-results/json-report
SCREENSHOT_DIR=./test-results/screenshots
VIDEO_DIR=./test-results/videos
TRACE_DIR=./test-results/traces

# Debug Configuration
DEBUG_MODE=false
HEADLESS=true
BROWSER_TIMEOUT=60000
ELEMENT_TIMEOUT=10000

# CI/CD Configuration
CI=false
CI_SHARD_INDEX=0
CI_SHARD_TOTAL=1

# External Services Configuration
SENTRY_DSN=
LOG_LEVEL=error

# Feature Flags
ENABLE_ANALYTICS_TESTS=true
ENABLE_GRAPH_TESTS=true
ENABLE_DOCUMENT_UPLOAD_TESTS=true
ENABLE_ADMIN_TESTS=true
ENABLE_MULTI_TENANT_TESTS=true
ENABLE_REAL_TIME_TESTS=true
