# Production Environment Configuration for Multimodal Enterprise RAG System

# Database Configuration
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://raguser:your_secure_postgres_password_here@postgres:5432/ragdb

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://redis:6379/0

# Neo4j Configuration
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# Qdrant Configuration
QDRANT_API_KEY=your_secure_qdrant_api_key_here
QDRANT_URL=http://qdrant:6333

# Application Configuration
SECRET_KEY=your_super_secret_application_key_change_this_in_production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# AI Service API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-35-turbo

# Monitoring Configuration
GRAFANA_PASSWORD=your_secure_grafana_password_here

# SSL/TLS Configuration
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Feature Flags
ENABLE_MULTIMODAL_PROCESSING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_EVALUATION_METRICS=true
ENABLE_REAL_TIME_PROCESSING=false

# Resource Limits
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_UPLOADS=10
WORKER_CONCURRENCY=4

# Security Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Performance Configuration
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500

# Monitoring and Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

# Email Configuration (for notifications)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password