# Coverage Configuration for RAG System Backend
# Following Temporal Python Testing pattern: Target ≥80% coverage

[run]
# Source to measure
source = src

# Enable branch coverage
branch = True

# Parallel mode for pytest-xdist
parallel = True

# Files to omit from coverage
omit =
    # Test files
    */tests/*
    */test_*
    */conftest.py

    # Migrations
    */migrations/*
    */alembic/*

    # Configuration
    */config/*

    # Virtual environments
    */venv/*
    */.venv/*

    # Cache
    */__pycache__/*
    */.pytest_cache/*

    # Type stubs
    *.pyi

[report]
# Regexes for lines to exclude from consideration
exclude_lines =
    # Have to re-enable the standard pragma
    pragma: no cover

    # Don't complain about missing debug-only code
    def __repr__
    def __str__

    # Don't complain if tests don't hit defensive assertions
    raise AssertionError
    raise NotImplementedError

    # Don't complain if non-runnable code isn't run
    if __name__ == .__main__.:
    if TYPE_CHECKING:

    # Don't complain about abstract methods
    @abstractmethod

    # Don't complain about pass statements
    pass

    # Logging debug lines
    logger\.debug
    logging\.debug

# Show missing lines in report
show_missing = True

# Fail if coverage is below threshold
# Note: pytest.ini --cov-fail-under takes precedence
fail_under = 60

# Precision for coverage percentage
precision = 2

# Sort report by coverage percentage
sort = Cover

[html]
# HTML report output directory
directory = coverage_html

# Title for the HTML report
title = RAG System Backend Coverage Report

[xml]
# XML report output for CI/CD
output = coverage.xml

[json]
# JSON report output
output = coverage.json
pretty_print = True

[paths]
# Map source paths for combined reports
source =
    src/
    /app/src/
