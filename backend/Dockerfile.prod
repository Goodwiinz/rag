# Production-optimized Dockerfile for Multimodal RAG Backend
# Multi-stage build with security hardening and performance optimization

ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim as base

# Install system dependencies with security updates
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    software-properties-common \
    git \
    libpq-dev \
    libffi-dev \
    libssl-dev \
    tesseract-ocr \
    tesseract-ocr-eng \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgl1-mesa-glx \
    curl \
    wget \
    procps \
    netcat \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_EXTRA_INDEX_URL="https://pypi.org/simple" \
    PATH="/app/.local/bin:$PATH"

# Create non-root user
RUN groupadd -r appuser && \
    useradd -r -g appuser -s /bin/bash -d /app appuser

# Set working directory
WORKDIR /app

# Stage 2: Build dependencies
FROM base as dependencies

# Copy requirements files
COPY backend/requirements.txt backend/requirements-minimal.txt ./

# Upgrade pip and install dependencies
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt

# Stage 3: Build with minimal dependencies
FROM base as production

# Copy Python dependencies
COPY --from=dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=dependencies /usr/local/bin /usr/local/bin

# Copy application code
COPY backend/ .

# Download spaCy model
RUN python -m spacy download en_core_web_sm --quiet

# Create necessary directories
RUN mkdir -p uploads logs models && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Install application as editable
RUN pip install -e .

# Set environment variables for production
ENV GUNICORN_WORKERS=4 \
    GUNICORN_THREADS=2 \
    GUNICORN_TIMEOUT=120 \
    GUNICORN_MAX_REQUESTS=1000 \
    GUNICORN_MAX_REQUESTS_JITTER=100

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with Gunicorn
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "--threads", "2", "--timeout", "120", "--max-requests", "1000", "--max-requests-jitter", "100", "--access-logfile", "-", "--error-logfile", "-", "src.main:app"]