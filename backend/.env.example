# Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED IN PRODUCTION/STAGING (will fail to start without these)
# =============================================================================

# Application secret key - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# JWT secret key for authentication - must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Neo4j database password
NEO4J_PASSWORD=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (set to false in production)
DEBUG=true

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_rag

# Redis connection URL
REDIS_URL=redis://localhost:6379

# Neo4j configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Supabase (local dev via supabase start)
SUPABASE_URL="http://localhost:54321"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_DB_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# =============================================================================
# AI/LLM API KEYS (Optional - for AI features)
# =============================================================================

# OpenAI API key
OPENAI_API_KEY=

# Anthropic API key
ANTHROPIC_API_KEY=

# Azure OpenAI configuration
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=

# =============================================================================
# PROCESSING CONFIGURATION
# =============================================================================

# Maximum concurrent processing jobs
MAX_CONCURRENT_JOBS=5

# Job retry configuration
JOB_RETRY_MAX=3
JOB_RETRY_DELAY=5

# =============================================================================
# SEARCH CONFIGURATION
# =============================================================================

# Default and maximum search result limits
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=50

# Embedding model (sentence_transformers, azure_openai, auto)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# =============================================================================
# FILE STORAGE
# =============================================================================

# Upload directory
UPLOAD_DIR=./uploads

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Free tier storage limit in GB
FREE_TIER_STORAGE_GB=10

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Enable metrics collection
ENABLE_METRICS=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
