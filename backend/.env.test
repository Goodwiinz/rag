# Test Environment Configuration
# This file contains configuration for testing environment

# Environment Settings
ENVIRONMENT=testing
DEBUG=true
LOG_LEVEL=INFO
TESTING=true

# Database Configuration
# Use SQLite for fast unit tests
DATABASE_URL=sqlite:///:memory:

# PostgreSQL for integration tests (uncomment if needed)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_rag_test

# Redis Configuration
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=testpassword
NEO4J_DATABASE=neo4j

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=30

# OpenAI Configuration (Mock/Test)
OPENAI_API_KEY=test-openai-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1000

# Anthropic Configuration (Mock/Test)
ANTHROPIC_API_KEY=test-anthropic-key
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_TEMPERATURE=0.1
ANTHROPIC_MAX_TOKENS=1000

# Embedding Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# Multi-Agent Configuration
CREWAI_VERBOSE=true
CREWAI_PROCESS=hierarchical
CREWAI_MANAGER_LLM=openai:gpt-3.5-turbo
CREWAI_MAX_RPM=100
CREWAI_SHARE_CREW=false

# Performance Testing
PERFORMANCE_TEST_DURATION=60
PERFORMANCE_TEST_USERS=10
PERFORMANCE_TEST_RAMP_UP=10
PERFORMANCE_TEST_RPS=100

# WebSocket Configuration
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MESSAGE_BATCH_SIZE=100

# Security Settings
SECRET_KEY=test-secret-key-for-jwt-tokens
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Background Tasks
SKIP_MIGRATIONS=false
DISABLE_BACKGROUND_TASKS=true
DISABLE_SCHEDULER=true

# File Upload
MAX_FILE_SIZE=10485760  # 10MB
UPLOAD_DIR=/tmp/test_uploads
ALLOWED_EXTENSIONS=pdf,txt,jpg,png,mp3,wav,mp4

# Monitoring & Logging
OTEL_ENABLED=false
PROMETHEUS_ENABLED=false
SENTRY_DSN=

# Test Data Generation
GENERATE_TEST_DATA=true
TEST_DATA_SIZE=100
TEST_DATA_LANGUAGES=en,es,fr,de

# External Service Mocking
MOCK_EXTERNAL_SERVICES=true
MOCK_OPENAI=true
MOCK_ANTHROPIC=true
MOCK_QDRANT=true
MOCK_NEO4J=true

# Performance Thresholds
RESPONSE_TIME_P95_THRESHOLD=2000  # ms
RESPONSE_TIME_P99_THRESHOLD=5000  # ms
ERROR_RATE_THRESHOLD=1.0           # %
THROUGHPUT_THRESHOLD=100           # requests/sec

# Test Specific Settings
SKIP_EXTERNAL_TESTS=false
SKIP_INTEGRATION_TESTS=false
SKIP_PERFORMANCE_TESTS=false
SKIP_WEBSOCKET_TESTS=false

# Coverage Settings
COVERAGE_MINIMUM=70
COVERAGE_SOURCE=src
COVERAGE_REPORT=html,xml,term

# Parallel Testing
PYTEST_XDIST_AUTO=auto
PYTEST_WORKERS=auto

# Randomization
RANDOMIZE_TESTS=false
TEST_SEED=42

# Database Connection Pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Cache Configuration
CACHE_TTL=300
CACHE_MAX_SIZE=1000
CACHE_ENABLED=false

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# API Configuration
API_V1_PREFIX=/api/v1
API_V2_PREFIX=/api/v2
API_DOCS_ENABLED=true
API_REDOC_ENABLED=true

# Multi-Modal Processing
OCR_ENABLED=false
SPEECH_TO_TEXT_ENABLED=false
IMAGE_PROCESSING_ENABLED=false
VIDEO_PROCESSING_ENABLED=false

# Evaluation Metrics
DEEPEVAL_ENABLED=false
RAGAS_ENABLED=false
EVALUATION_BATCH_SIZE=10

# Search Configuration
DEFAULT_SEARCH_LIMIT=10
MAX_SEARCH_LIMIT=100
SEARCH_TIMEOUT=30
SEARCH_RERANK_ENABLED=true