{
  "dashboard": {
    "id": null,
    "title": "Multimodal RAG System",
    "description": "Comprehensive monitoring dashboard for the Multimodal RAG System with WebSocket support",
    "tags": ["multimodal-rag", "production", "websocket"],
    "timezone": "browser",
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "System Overview",
        "type": "stat",
        "targets": [
          {
            "expr": "up",
            "legendFormat": "{{ instance }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {
                "options": {
                  "0": {
                    "text": "DOWN"
                  },
                  "1": {
                    "text": "UP"
                  }
                },
                "type": "value"
              }
            ],
            "thresholds": {
              "steps": [
                {
                  "color": "red",
                  "value": 0
                },
                {
                  "color": "green",
                  "value": 1
                }
              ]
            },
            "unit": "none"
          }
        }
      },
      {
        "id": 2,
        "title": "Backend Service Health",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{ method }} {{ status }}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "req/s"
          }
        }
      },
      {
        "id": 3,
        "title": "WebSocket Connections",
        "type": "graph",
        "targets": [
          {
            "expr": "websocket_connections_total",
            "legendFormat": "Total Connections"
          },
          {
            "expr": "rate(websocket_connections_total[5m])",
            "legendFormat": "Connection Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "connections"
          }
        }
      },
      {
        "id": 4,
        "title": "WebSocket Message Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(websocket_messages_total[5m])",
            "legendFormat": "Message Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "msg/s"
          }
        }
      },
      {
        "id": 5,
        "title": "Response Time Percentiles",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "seconds"
          }
        }
      },
      {
        "id": 6,
        "title": "Error Rate by Status Code",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (status)",
            "legendFormat": "5xx Errors"
          },
          {
            "expr": "sum(rate(http_requests_total{status=~\"4..\"}[5m])) by (status)",
            "legendFormat": "4xx Errors"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "req/s"
          }
        }
      },
      {
        "id": 7,
        "title": "WebSocket Latency",
        "type": "graph",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(websocket_message_latency_seconds_bucket[5m]))",
            "legendFormat": "50th percentile"
          },
          {
            "expr": "histogram_quantile(0.95, rate(websocket_message_latency_seconds_bucket[5m]))",
            "legendFormat": "95th percentile"
          },
          {
            "expr": "histogram_quantile(0.99, rate(websocket_message_latency_seconds_bucket[5m]))",
            "legendFormat": "99th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "seconds"
          }
        }
      },
      {
        "id": 8,
        "title": "Memory Usage by Service",
        "type": "graph",
        "targets": [
          {
            "expr": "container_memory_working_set_bytes{service=\"backend\"}",
            "legendFormat": "Backend Memory"
          },
          {
            "expr": "container_memory_working_set_bytes{service=\"frontend\"}",
            "legendFormat": "Frontend Memory"
          },
          {
            "expr": "container_memory_working_set_bytes{service=\"websocket\"}",
            "legendFormat": "WebSocket Memory"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 9,
        "title": "CPU Usage by Service",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{service=\"backend\"}[5m])) by (service)",
            "legendFormat": "Backend CPU"
          },
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{service=\"frontend\"}[5m])) by (service)",
            "legendFormat": "Frontend CPU"
          },
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{service=\"websocket\"}[5m])) by (service)",
            "legendFormat": "WebSocket CPU"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "seconds"
          }
        }
      },
      {
        "id": 10,
        "title": "Database Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(pg_stat_database_numbackends[5m])",
            "legendFormat": "PostgreSQL Connections"
          },
          {
            "expr": "histogram_quantile(0.95, rate(pg_stat_database_call_time_seconds_sum[5m]))",
            "legendFormat": "Query Time 95th percentile"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "connections"
          }
        }
      },
      {
        "id": 11,
        "title": "Redis Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total[5m])",
            "legendFormat": "Cache Hits"
          },
          {
            "expr": "rate(redis_keyspace_misses_total[5m])",
            "legendFormat": "Cache Misses"
          },
          {
            "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
            "legendFormat": "Cache Hit Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "req/s"
          }
        }
      },
      {
        "id": 12,
        "title": "Neo4j Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(neo4j_jmx_db_stats_queries[5m])",
            "legendFormat": "Query Rate"
          },
          {
            "expr": "neo4j_memory_used",
            "legendFormat": "Memory Used"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "queries/s"
          }
        }
      },
      {
        "id": 13,
        "title": "Qdrant Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(qdrant_request_duration_seconds_sum[5m])",
            "legendFormat": "Request Time"
          },
          {
            "expr": "rate(qdrant_request_total[5m])",
            "legendFormat": "Request Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "seconds"
          }
        }
      },
      {
        "id": 14,
        "title": "Document Processing Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(documents_processed_total[5m])",
            "legendFormat": "Processing Rate"
          },
          {
            "expr": "sum(documents_processed_total)",
            "legendFormat": "Total Processed"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "docs/s"
          }
        }
      },
      {
        "id": 15,
        "title": "AI Model Performance",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(ai_model_inference_duration_seconds_sum[5m])",
            "legendFormat": "Inference Time"
          },
          {
            "expr": "rate(ai_model_requests_total[5m])",
            "legendFormat": "Request Rate"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "seconds"
          }
        }
      },
      {
        "id": 16,
        "title": "System Alerts",
        "type": "table",
        "targets": [
          {
            "expr": "ALERTS{severity=\"critical\"} == 1",
            "legendFormat": "Critical Alerts"
          },
          {
            "expr": "ALERTS{severity=\"warning\"} == 1",
            "legendFormat": "Warning Alerts"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        }
      },
      {
        "id": 17,
        "title": "WebSocket Error Rate",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(websocket_errors_total[5m])",
            "legendFormat": "Error Rate"
          },
          {
            "expr": "rate(websocket_messages_total[5m])",
            "legendFormat": "Message Rate"
          },
          {
            "expr": "rate(websocket_errors_total[5m]) / rate(websocket_messages_total[5m])",
            "legendFormat": "Error Ratio"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "errors/s"
          }
        }
      },
      {
        "id": 18,
        "title": "Network Throughput",
        "type": "graph",
        "targets": [
          {
            "expr": "rate(container_network_transmit_bytes_total[5m])",
            "legendFormat": "Network Out"
          },
          {
            "expr": "rate(container_network_receive_bytes_total[5m])",
            "legendFormat": "Network In"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes"
          }
        }
      },
      {
        "id": 19,
        "title": "Storage Usage",
        "type": "graph",
        "targets": [
          {
            "expr": "node_filesystem_avail_bytes / node_filesystem_size_bytes * 100",
            "legendFormat": "Available Space"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent"
          }
        }
      },
      {
        "id": 20,
        "title": "Load Average",
        "type": "graph",
        "targets": [
          {
            "expr": "node_load1",
            "legendFormat": "1-minute load"
          },
          {
            "expr": "node_load5",
            "legendFormat": "5-minute load"
          },
          {
            "expr": "node_load15",
            "legendFormat": "15-minute load"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          }
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    },
    "templating": {
      "list": [
        {
          "name": "timeRange",
          "type": "custom",
          "query": "5m,15m,30m,1h,6h,12h,1d,7d,30d",
          "current": {
            "selected": false,
            "text": "5m",
            "value": "5m"
          },
          "options": [
            {
              "selected": true,
              "text": "5m",
              "value": "5m"
            },
            {
              "selected": false,
              "text": "15m",
              "value": "15m"
            },
            {
              "selected": false,
              "text": "30m",
              "value": "30m"
            },
            {
              "selected": false,
              "text": "1h",
              "value": "1h"
            },
            {
              "selected": false,
              "text": "6h",
              "value": "6h"
            },
            {
              "selected": false,
              "text": "12h",
              "value": "12h"
            },
            {
              "selected": false,
              "text": "1d",
              "value": "1d"
            },
            {
              "selected": false,
              "text": "7d",
              "value": "7d"
            },
            {
              "selected": false,
              "text": "30d",
              "value": "30d"
            }
          ]
        }
      ]
    }
  }
}