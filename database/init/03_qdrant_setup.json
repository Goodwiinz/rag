  },
  "health_checks": [
    {
      "name": "collection_health",
      "description": "Check if all required collections exist and are healthy",
      "endpoint": "/collections/{collection_name}",
      "expected_status": 200,
      "collections": ["documents", "entities", "multimodal", "search_sessions", "knowledge_graph"]
    },
    {
      "name": "search_performance",
      "description": "Test search performance with sample queries",
      "endpoint": "/collections/documents/points/search",
      "method": "POST",
      "expected_response_time_ms": 500,
      "payload": {
        "vector": [0.1, 0.2, 0.3],
        "limit": 10,
        "with_payload": true,
        "with_vector": false
      }
    },
    {
      "name": "cluster_health",
      "description": "Check overall cluster health",
      "endpoint": "/health",
      "expected_status": 200
    }
  ],
  "maintenance": {
    "cleanup_policies": [
      {
        "collection": "search_sessions",
        "type": "time_based",
        "retention_days": 30,
        "filter": {
          "must": [
            {
              "key": "session_end",
              "range": {
                "lt": "now-30d"
              }
            }
          ]
        }
      }
    ],
    "optimization_schedules": [
      {
        "collection": "documents",
        "operation": "optimize",
        "schedule": "0 2 * * *",
        "description": "Daily optimization at 2 AM"
      },
      {
        "collection": "entities",
        "operation": "compact",
        "schedule": "0 3 * * 0",
        "description": "Weekly compaction on Sunday at 3 AM"
      }
    ]
  }
}