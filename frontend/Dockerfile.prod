# Multi-stage production Dockerfile for React Frontend
# Optimized for production with caching and security

# Stage 1: Base image for node
FROM node:18-alpine AS base

# Install pnpm if needed
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Stage 2: Install dependencies
FROM base AS deps

# Copy package files
COPY frontend/package.json frontend/package-lock.json ./
COPY frontend/pnpm-lock.yaml ./ 2>/dev/null || true

# Install dependencies
RUN pnpm install --frozen-lockfile

# Stage 3: Build application
FROM base AS builder

# Copy installed dependencies
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/.pnpm-store /app/.pnpm-store

# Copy source code
COPY frontend/ .

# Build the application
RUN pnpm build

# Stage 4: Production image
FROM base AS runner

# Create directories
WORKDIR /app

# Set permissions
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/pnpm-lock.yaml ./pnpm-lock.yaml 2>/dev/null || true

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create uploads directory
RUN mkdir -p uploads && chown nextjs:nodejs uploads

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start the application
CMD ["node", "server.js"]