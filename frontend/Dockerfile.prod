# syntax=docker/dockerfile:1
# Multi-stage production Dockerfile for React Frontend
# Optimized for production with caching and security
# Optimized for remote builds

# Stage 1: Base image for node
FROM node:25-alpine AS base

# Install pnpm if needed
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Stage 2: Install dependencies
FROM base AS deps

# Copy package.json first
COPY frontend/package.json ./

# Install dependencies — force linux platform to avoid darwin-arm64 optional deps
RUN npm install --force && npm cache clean --force

# Stage 3: Build application
FROM base AS builder

# Non-secret build-time args (safe to bake into image layers)
ARG NEXT_PUBLIC_API_BASE_URL
ARG BACKEND_URL

ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV BACKEND_URL=$BACKEND_URL

# Copy installed dependencies
COPY --from=deps /app/node_modules /app/node_modules

# Copy source code
COPY frontend/ .

# Build the application using BuildKit secret mount for sensitive NEXT_PUBLIC_* vars.
# Secrets are injected via --mount and only exist during this RUN layer — they are
# NOT persisted in the image history.  When no secret is mounted (local dev), the
# build still succeeds with empty env vars.
RUN --mount=type=secret,id=frontend_env \
    if [ -f /run/secrets/frontend_env ]; then \
      set -a && . /run/secrets/frontend_env && set +a; \
    fi && \
    npm run build

# Stage 4: Production image
FROM base AS runner

# Create directories
WORKDIR /app

# User already created in base stage

# Copy built application (standalone outputs to .next/standalone/app for workdir /app)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone/app ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

# Copy public folder if it exists (may not exist in all projects)
RUN mkdir -p public

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create uploads directory
RUN mkdir -p uploads && chown nextjs:nodejs uploads

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start the application
CMD ["node", "server.js"]
