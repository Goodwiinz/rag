# syntax=docker/dockerfile:1
# Multi-stage production Dockerfile for React Frontend
# Optimized for production with caching and security
# Optimized for remote builds

# Stage 1: Base image for node
FROM node:25-alpine AS base

# Install pnpm if needed
RUN npm install -g pnpm

# Install curl for healthchecks
RUN apk add --no-cache curl

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Stage 2: Install dependencies
FROM base AS deps

# Copy package.json first
COPY frontend/package.json ./

# Install dependencies — force linux platform to avoid darwin-arm64 optional deps
RUN npm install --force && npm cache clean --force

# Stage 3: Build application
FROM base AS builder

# Build-time env vars (NEXT_PUBLIC_* are baked into client JS by Next.js)
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_STATSIG_CLIENT_KEY
ARG NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_APP_ENV
ARG SENTRY_ORG
ARG SENTRY_PROJECT
ARG BACKEND_URL
ARG NEXT_PUBLIC_GIT_SHA

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_STATSIG_CLIENT_KEY=$NEXT_PUBLIC_STATSIG_CLIENT_KEY
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV SENTRY_ORG=$SENTRY_ORG
ENV SENTRY_PROJECT=$SENTRY_PROJECT
ENV BACKEND_URL=$BACKEND_URL
ENV NEXT_PUBLIC_GIT_SHA=$NEXT_PUBLIC_GIT_SHA

# Copy installed dependencies
COPY --from=deps /app/node_modules /app/node_modules

# Copy source code
COPY frontend/ .

# Build the application
# SENTRY_AUTH_TOKEN is mounted as a secret so source map upload works without
# leaking the token into image history. Build still succeeds if the secret is
# absent — withSentryConfig just skips upload (runtime error tracking is
# unaffected, but stack traces won't be symbolicated).
RUN --mount=type=secret,id=sentry_auth_token,env=SENTRY_AUTH_TOKEN \
    if [ -z "$NEXT_PUBLIC_SUPABASE_URL" ] || [ -z "$NEXT_PUBLIC_SUPABASE_ANON_KEY" ]; then \
      echo "NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY must be set at build time." >&2; \
      exit 1; \
    fi && \
    npm run build

# Stage 4: Production image
FROM base AS runner

# Create directories
WORKDIR /app

# User already created in base stage

# Copy built application (standalone outputs to .next/standalone/app for workdir /app)
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone/app ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

# Copy public folder if it exists (may not exist in all projects)
RUN mkdir -p public

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create uploads directory
RUN mkdir -p uploads && chown nextjs:nodejs uploads

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start the application
CMD ["node", "server.js"]
