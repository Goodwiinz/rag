# syntax=docker/dockerfile:1
# Multi-stage production Dockerfile for React Frontend
# Optimized for production with caching and security
# Optimized for Depot remote builds with BuildKit cache mounts

# Stage 1: Base image for node
FROM node:18-alpine AS base

# Install pnpm if needed
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

# Stage 2: Install dependencies
FROM base AS deps

# Copy package.json first (lock file may not exist)
COPY frontend/package.json ./

# Copy lock file if it exists (supports npm, pnpm, or yarn)
COPY frontend/package-lock.jso[n] frontend/pnpm-lock.yam[l] frontend/yarn.loc[k] ./

# Install dependencies with cache mount for faster rebuilds
# Use npm ci if lock file exists, otherwise npm install
RUN --mount=type=cache,target=/root/.npm \
    if [ -f package-lock.json ]; then \
      npm ci; \
    elif [ -f pnpm-lock.yaml ]; then \
      pnpm install --frozen-lockfile; \
    else \
      npm install && npm cache clean --force; \
    fi

# Stage 3: Build application
FROM base AS builder

# Copy installed dependencies
COPY --from=deps /app/node_modules /app/node_modules

# Copy source code
COPY frontend/ .

# Build the application
RUN npm run build

# Stage 4: Production image
FROM base AS runner

# Create directories
WORKDIR /app

# User already created in base stage

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json

# Copy public folder if it exists (may not exist in all projects)
RUN mkdir -p public

# Set environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create uploads directory
RUN mkdir -p uploads && chown nextjs:nodejs uploads

# Switch to non-root user
USER nextjs

# Expose port
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:3000/ || exit 1

# Start the application
CMD ["node", "server.js"]