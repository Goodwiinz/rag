# API Configuration
# Server-side rewrite target used by next.config.js. Required on Vercel unless
# NEXT_PUBLIC_API_URL is set.
BACKEND_URL=http://localhost:8000
# Public browser endpoint. Leave unset locally to use the Next.js rewrite path.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=

# Application Settings
REACT_APP_APP_NAME="Multimodal RAG System"
REACT_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_GRAPH_VISUALIZATION=true
REACT_APP_ENABLE_EVALUATION_METRICS=true

# Upload Limits
REACT_APP_MAX_FILE_SIZE_MB=50
REACT_APP_MAX_FILES_PER_UPLOAD=10

# Performance Settings
REACT_APP_DEBOUNCE_DELAY_MS=300
REACT_APP_WEBSOCKET_RETRY_ATTEMPTS=5
REACT_APP_CACHE_DURATION_MS=300000

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_LOG_LEVEL=debug

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # From: npx supabase status (anon key)

# Statsig (client SDK key — public, baked into the browser bundle by Next.js
# at build time. Get from https://console.statsig.com → Project → Keys)
NEXT_PUBLIC_STATSIG_CLIENT_KEY=client-SEfCB81zQnvSAqRxfVi1nJNRmpJtrmOrvDKQPQm4UBx

# Sentry (error monitoring + tracing)
# DSN is public — find it at Sentry → Settings → Projects → <project> → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Org/project slugs used by withSentryConfig for source map upload
SENTRY_ORG=goodwiinz-uk
SENTRY_PROJECT=nous-frontend
# Build-time auth token: store in .env.sentry-build-plugin (gitignored), NOT here

# Trigger.dev (server-side only — do NOT prefix with NEXT_PUBLIC_)
TRIGGER_SECRET_KEY=