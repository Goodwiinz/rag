{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vitest/globals", "node", "@testing-library/jest-dom/vitest"]
  },
  "include": [
    "src/test/**/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*",
    "src/**/*.d.ts",
    "cli/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
