    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "react-router-dom": "^6.30.3",
    "shadcn": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.1.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/**/*.{test,spec}.{ts,tsx}",
    "test:integration": "jest src/**/*.integration.{test,spec}.{ts,tsx}",
    "test:component": "jest src/**/*.{test,spec}.{ts,tsx}",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:smoke": "playwright test --grep=@smoke",
    "test:e2e:regression": "playwright test --grep=@regression",
    "test:e2e:accessibility": "playwright test --project=accessibility",
    "test:e2e:performance": "playwright test --project=performance",
    "test:e2e:visual": "playwright test --project=visual",
    "test:e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=iPhone --project=Android",
    "test:e2e:report": "playwright test --reporter=html",
    "test:e2e:update-snapshots": "playwright test --update-snapshots",
    "test:e2e:codegen": "playwright codegen",
    "test:e2e:install": "playwright install --with-deps",
    "test:e2e:show-report": "playwright show-report",
    "test:e2e:show-trace": "playwright show-trace trace.zip",
    "lint": "eslint --ext .ts,.tsx --max-warnings=9999 --ignore-pattern node_modules --ignore-pattern .next --ignore-pattern e2e --ignore-pattern tests --ignore-pattern '*.test.*' --ignore-pattern '*.spec.*' --ignore-pattern setupTests.ts app src",
    "lint:fix": "eslint --ext .ts,.tsx --max-warnings=9999 --fix --ignore-pattern node_modules --ignore-pattern .next --ignore-pattern e2e --ignore-pattern tests --ignore-pattern '*.test.*' --ignore-pattern '*.spec.*' --ignore-pattern setupTests.ts app src",
    "format": "prettier --write src/**/*.{ts,tsx,css,md}",
    "format:check": "prettier --check src/**/*.{ts,tsx,css,md}",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run test",
    "generate-types": "bash ../scripts/generate-api-types.sh",
    "capture": "node scripts/capture.js"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-hooks"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "rules": {
      "react/react-in-jsx-scope": "off",
      "@typescript-eslint/no-unused-vars": [
        "warn",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ]
    }
  },
  "prettier": {
    "semi": true,
    "trailingComma": "es5",
    "singleQuote": true,
    "printWidth": 80,
    "tabWidth": 2
  },
  "browserslist": {
    "production": [
      "defaults and fully supports es6-module",
      "maintained node versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:8000"
}
