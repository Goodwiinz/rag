{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "es6"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "downlevelIteration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/nous": [
        "./app/components/nous/index.ts"
      ],
      "@/nous/*": [
        "./app/components/nous/*"
      ],
      "@/*": [
        "./src/*",
        "./app/*"
      ],
      "@/components/*": [
        "./src/components/*"
      ],
      "@/lib/*": [
        "./src/lib/*"
      ],
      "@/hooks/*": [
        "./src/hooks/*"
      ],
      "@/types/*": [
        "./src/types/*"
      ],
      "@/utils/*": [
        "./src/utils/*"
      ],
      "@/stores/*": [
        "./src/stores/*"
      ],
      "@/styles/*": [
        "./src/styles/*"
      ],
      "@test/*": [
        "./src/test/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next/dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "e2e/**/*",
    "examples/**/*",
    "src/components/__tests__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.stories.ts",
    "**/*.stories.tsx",
    "playwright.config.ts",
    "src/components/layout/AppLayout.tsx",
    "src/components/layout/Header.tsx",
    "src/components/layout/Layout.tsx",
    "src/components/layout/Sidebar.tsx",
    "src/components/layout/sidebar-demo.tsx",
    "src/components/optimized/OptimizedDocumentList.tsx",
    "src/components/performance/PerformanceDashboardsMUI.tsx",
    "src/components/realtime/DocumentProcessingCard.tsx",
    "src/components/realtime/DocumentProcessingDashboard.tsx",
    "src/components/graph/GraphWebSocketProvider.tsx",
    "src/components/graph/ResponsiveGraphLayout.tsx",
    "src/components/monitoring/PerformanceMetricsDashboard.tsx",
    "src/components/monitoring/SystemOverviewDashboard.tsx",
    "src/components/processing/NotificationCenter.tsx",
    "src/components/processing/ConnectionManager.tsx",
    "src/components/processing/PerformanceMonitor.tsx",
    "src/components/processing/RealtimeStatusDashboard.tsx",
    "src/components/realtime/ProcessingProgressBar.tsx",
    "src/components/realtime/RealtimeProcessingDashboard.tsx",
    "src/components/realtime/RealtimeProcessingProvider.tsx",
    "src/components/realtime/VirtualizedDocumentList.tsx",
    "src/components/search/QueryRewriter.tsx",
    "src/components/search/ResultAggregator.tsx",
    "src/components/ui/enhanced-new-chat-dialog.tsx",
    "src/components/ui/enhanced-sidebar-menu-item.tsx",
    "src/components/layout/dashboard/DashboardLayout.tsx",
    "src/components/ui/enhanced-sidebar.tsx",
    "src/components/ui/shadcn-io/**/*",
    "src/router/**/*",
    "src/examples/**/*",
    "src/hooks/analytics/**/*",
    "src/hooks/useDocuments.ts",
    "src/hooks/useEvaluation.ts",
    "src/hooks/useRealtimeProcessing.ts",
    "src/hooks/useWebSocketConnection.ts",
    "src/lib/analytics.ts",
    "src/lib/thread-hooks.ts",
    "src/page-components/**/*",
    "src/performance/**/*",
    "src/services/analytics/**/*",
    "src/services/enhancedDocumentService.v2.ts",
    "src/services/graphAnalyticsService.ts",
    "src/services/graphService.ts",
    "src/services/monitoringWebsocketService.ts",
    "src/services/realtime-websocket-service.ts",
    "src/services/searchService.ts",
    "src/services/typeSafeApiClient.ts",
    "src/components/documents/DocumentLibrary.tsx",
    "src/components/evaluation/EvaluationManagement.tsx",
    "src/hooks/useAnalyticsTracking.ts",
    "src/components/analytics/AnalyticsProvider.tsx",
    "src/components/dashboard/QuickActionsGrid.tsx",
    "src/store/realtime-store.ts",
    "src/store/realtimeProcessingStore.ts",
    "src/providers/WebSocketProvider.tsx",
    "src/stores/analytics/**/*",
    "src/utils/analytics/**/*",
    "app/analytics/page.tsx",
    "app/search/page.tsx",
    "app/dashboard/page.tsx",
    "src/components/graph/EnhancedKnowledgeGraphViewer.tsx",
    "src/components/graph/KnowledgeGraphViewer.tsx",
    "app/components/realtime/RealtimeStatusDashboard.tsx",
    "app/components/AppNavbar.tsx",
    "src/stores/graphStore.ts",
    "src/stores/monitoringStore.ts",
    "src/test/setup.ts",
    "src/trigger/**/*",
    "trigger.config.ts",
    "src/remotion/**/*"
  ]
}
