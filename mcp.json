{
  "mcpServers": {
   
    "redis": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-redis", "redis://localhost:6379"]
    },
    "goodflows": {
      "command": "npx",
      "args": ["goodflows-mcp-server", "--project", "/Users/goodwiinz/development/RAG_system"],
      "cwd": "/Users/goodwiinz/development/Myagent"
    },
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote","https://mcp.linear.app/mcp"],
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      }
    }
  }
}
