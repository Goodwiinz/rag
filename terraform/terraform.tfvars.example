# Example Terraform Variables Configuration
# Copy this file to terraform.tfvars and update with your values

# AWS Configuration
aws_region = "us-west-2"
environment = "staging"
owner = "rag-team"
domain_name = "rag-staging.yourdomain.com"

# Cloudflare
cloudflare_api_token = "your_cloudflare_api_token_here"

# Network Configuration
vpc_cidr_block = "10.0.0.0/16"
public_subnet_cidrs = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]
database_subnet_cidrs = ["10.0.21.0/24", "10.0.22.0/24", "10.0.23.0/24"]

enable_nat_gateway = true
one_nat_gateway_per_az = false
enable_vpn_gateway = false

# Kubernetes Configuration
kubernetes_version = "1.28"

# Application Node Group
application_node_count = 3
application_node_min_count = 2
application_node_max_count = 10
application_instance_types = ["m5.xlarge", "m5.2xlarge"]

# Worker Node Group
worker_node_count = 4
worker_node_min_count = 2
worker_node_max_count = 8
worker_instance_types = ["m5.2xlarge", "m5.4xlarge"]

# System Node Group
system_node_count = 2
system_node_min_count = 1
system_node_max_count = 3
system_instance_types = ["m5.large", "m5.xlarge"]

# Database Configuration
database_instance_class = "db.r5.xlarge"
database_storage_size = 100
database_max_storage_size = 1000
backup_retention_period = 7
backup_window = "03:00-04:00"
maintenance_window = "sun:04:00-sun:05:00"

# Redis Configuration
redis_node_type = "cache.r5.large"
redis_node_count = 1

# Monitoring and Logging
enable_monitoring = true
enable_logging = true

# Additional Tags
tags = {
  CostCenter = "engineering"
  Project = "multimodal-rag"
  Environment = "staging"
}