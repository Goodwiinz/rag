{
  "name": "multimodal-rag-monorepo",
  "version": "1.0.0",
  "description": "Multimodal Enterprise RAG System - Monorepo Root",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "frontend",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace=tests/e2e",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "install:all": "npm install",
    "trigger:dev": "pnpm dlx trigger.dev@4.4.6 dev",
    "trigger:deploy": "pnpm dlx trigger.dev@4.4.6 deploy"
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.6"
  },
  "engines": {
    "node": "24.x",
    "npm": ">=9.6.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/multimodal-rag-system"
  },
  "keywords": [
    "rag",
    "multimodal",
    "enterprise",
    "knowledge-graph",
    "nextjs"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "jsonpath": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
