{
  "name": "multimodal-rag-monorepo",
  "version": "1.0.0",
  "description": "Multimodal Enterprise RAG System - Monorepo Root",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "workspaces": [
    "frontend",
    "tests/e2e"
  ],
  "scripts": {
    "dev": "pnpm --filter multimodal-rag-frontend dev",
    "build": "pnpm --filter multimodal-rag-frontend build",
    "build:frontend": "pnpm --filter multimodal-rag-frontend build",
    "start": "pnpm --filter multimodal-rag-frontend start",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter ./tests/e2e test:e2e",
    "validate": "pnpm --filter multimodal-rag-frontend validate",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules",
    "install:all": "pnpm install",
    "trigger:dev": "pnpm dlx trigger.dev@4.4.6 dev",
    "trigger:deploy": "pnpm dlx trigger.dev@4.4.6 deploy"
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.4.6"
  },
  "pnpm": {
    "overrides": {
      "nanoid@^3": "3.3.18",
      "js-yaml@^4": "4.3.1",
      "socket.io-parser@^4": "4.2.7",
      "engine.io@^6": "6.6.7",
      "hono@^4.12": "4.12.34",
      "sharp@^0.34": "0.35.0",
      "systeminformation@^5.31": "5.31.7",
      "@trigger.dev/core@^4": "4.5.6",
      "@opentelemetry/core@2.0.1": "2.10.0",
      "cookie@^0.4": "0.7.2",
      "protobufjs@^7.6": "7.6.5",
      "tmp@^0.2": "0.2.7",
      "brace-expansion@^1": "1.1.18",
      "uuid@^11.0.0": "11.1.1",
      "postcss@^8": "8.5.23",
      "ws@^8": "8.21.0",
      "uuid@^8": "11.1.1",
      "@opentelemetry/core@^2.0.0": "2.10.0"
    }
  },
  "engines": {
    "node": "24.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/multimodal-rag-system"
  },
  "keywords": [
    "rag",
    "multimodal",
    "enterprise",
    "knowledge-graph",
    "nextjs"
  ],
  "author": "",
  "license": "MIT"
}
