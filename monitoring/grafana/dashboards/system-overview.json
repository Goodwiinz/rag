      "pluginVersion": "9.0.0",
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "up",
          "format": "table",
          "instant": true,
          "legendFormat": "{{job}} - {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Service Status",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
