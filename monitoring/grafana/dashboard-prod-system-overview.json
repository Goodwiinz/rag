  "links": [],
  "panels": [
    {
      "collapsed": false,
      "datasource": "Prometheus",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "RAG System Overview Dashboard",
      "type": "row"
    },
    {
      "datasource": "Prometheus",
      "description": "System uptime and service availability",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "up{job=~'rag-backend|rag-frontend|rag-postgres|rag-redis|rag-neo4j|rag-qdrant'}",
          "interval": "30s",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ],
      "title": "Service Status",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "CPU usage across all services",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "100 - (avg by(instance) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "interval": "30s",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "CPU Usage",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Memory usage across all services",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
          "interval": "30s",
          "legendFormat": "{{ instance }}",
          "refId": "A"
        }
      ],
      "title": "Memory Usage",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "HTTP request rates and status codes",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (job)",
          "interval": "30s",
          "legendFormat": "{{ job }}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Database performance metrics",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 6,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "interval": "30s",
          "legendFormat": "PostgreSQL Connections",
          "refId": "A"
        },
        {
          "expr": "pg_stat_database_xact_commit",
          "interval": "30s",
          "legendFormat": "PostgreSQL Commits",
          "refId": "B"
        },
        {
          "expr": "pg_stat_database_xact_rollback",
          "interval": "30s",
          "legendFormat": "PostgreSQL Rollbacks",
          "refId": "C"
        }
      ],
      "title": "Database Metrics",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Request latency percentiles",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 7,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m])) by (job)",
          "interval": "30s",
          "legendFormat": "{{ job }} - 50th %",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, rate(http_request_duration_seconds_bucket[5m])) by (job)",
          "interval": "30s",
          "legendFormat": "{{ job }} - 90th %",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) by (job)",
          "interval": "30s",
          "legendFormat": "{{ job }} - 95th %",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m])) by (job)",
          "interval": "30s",
          "legendFormat": "{{ job }} - 99th %",
          "refId": "D"
        }
      ],
      "title": "Request Latency",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "description": "RAG-specific metrics",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 8,
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "sum(rate(rag_vector_search_requests_total[5m]))",
          "interval": "30s",
          "legendFormat": "Vector Searches",
          "refId": "A"
        },
        {
          "expr": "sum(rate(rag_llm_requests_total[5m]))",
          "interval": "30s",
          "legendFormat": "LLM Requests",
          "refId": "B"
        },
        {
          "expr": "sum(rate(rag_document_uploads_total[5m]))",
          "interval": "30s",
          "legendFormat": "Document Uploads",
          "refId": "C"
        }
      ],
      "title": "RAG Activity",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Error rates by status code",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 9,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [],
          "fields": "",
          "values": true
        },
        "showUnfilled": true,
        "text": {}
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total[5m]))",
          "interval": "30s",
          "legendFormat": "HTTP {{ status }}",
          "refId": "A"
        }
      ],
      "title": "HTTP Status Codes",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "System load and response times",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 10,
      "options": {
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom"
        },
        "orientation": "auto",
        "showPoints": "never",
        "showValues": false,
        "xTickLabelRotation": 0
      },
      "pluginVersion": "8.3.3",
      "targets": [
        {
          "expr": "node_load1",
          "interval": "30s",
          "legendFormat": "1-min load",
          "refId": "A"
        },
        {
          "expr": "node_load5",
          "interval": "30s",
          "legendFormat": "5-min load",
          "refId": "B"
        },
        {
          "expr": "node_load15",
          "interval": "30s",
          "legendFormat": "15-min load",
          "refId": "C"
        }
      ],
      "title": "System Load",
      "type": "timeseries"
    }
