# Monitoring Stack Environment Variables
# Copy this file to .env and update with your secure values
# NEVER commit the .env file to version control!

# ==============================================================================
# GRAFANA CONFIGURATION
# ==============================================================================
# Admin credentials - CHANGE THESE IMMEDIATELY!
# Use a strong password generator: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# Grafana Security Settings
GRAFANA_SECRET_KEY=CHANGE_ME_IMMEDIATELY
GRAFANA_DISABLE_GRAVATAR=true
GRAFANA_ALLOW_SIGN_UP=false

# ==============================================================================
# PROMETHEUS CONFIGURATION
# ==============================================================================
PROMETHEUS_RETENTION=15d
PROMETHEUS_RETENTION_SIZE=10GB

# ==============================================================================
# ALERTMANAGER CONFIGURATION
# ==============================================================================
# Slack webhook for alerts (optional)
ALERTMANAGER_SLACK_WEBHOOK_URL=
ALERTMANAGER_SLACK_CHANNEL=#alerts

# Email configuration for alerts (optional)
ALERTMANAGER_SMTP_FROM=
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=

# PagerDuty integration (optional)
ALERTMANAGER_PAGERDUTY_SERVICE_KEY=

# ==============================================================================
# LOKI CONFIGURATION
# ==============================================================================
LOKI_RETENTION_PERIOD=744h
LOKI_STORAGE_SIZE=10GB

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis password - CHANGE THIS!
REDIS_PASSWORD=CHANGE_ME_IMMEDIATELY
REDIS_MAXMEMORY=512mb

# ==============================================================================
# JAEGER CONFIGURATION
# ==============================================================================
JAEGER_ADMIN_USER=admin
JAEGER_ADMIN_PASSWORD=CHANGE_ME_IMMEDIATELY

# ==============================================================================
# OPENTELEMETRY CONFIGURATION
# ==============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_PROMETHEUS_ENDPOINT=http://prometheus:9090

# ==============================================================================
# NETWORK CONFIGURATION
# ==============================================================================
# Ports - modify if conflicts exist
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
JAEGER_UI_PORT=16686
LOKI_PORT=3100
REDIS_PORT=6379
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# ==============================================================================
# RESOURCE LIMITS
# ==============================================================================
# Adjust based on your system resources
PROMETHEUS_MEMORY_LIMIT=2G
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_MEMORY_LIMIT=512M
GRAFANA_CPU_LIMIT=0.5
JAEGER_MEMORY_LIMIT=1G
JAEGER_CPU_LIMIT=0.5
LOKI_MEMORY_LIMIT=1G
LOKI_CPU_LIMIT=0.5

# ==============================================================================
# DATA PERSISTENCE
# ==============================================================================
# Host paths for data persistence (optional, defaults to Docker volumes)
PROMETHEUS_DATA_PATH=./data/prometheus
GRAFANA_DATA_PATH=./data/grafana
LOKI_DATA_PATH=./data/loki
REDIS_DATA_PATH=./data/redis
ALERTMANAGER_DATA_PATH=./data/alertmanager
