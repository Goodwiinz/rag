# =============================================================================
# Production Environment Configuration
# =============================================================================
# This file contains production environment variables for deploying the
# Multimodal Enterprise RAG System. Update values according to your production environment.

# =============================================================================
# Security Configuration
# =============================================================================
# Generate strong secrets using: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-change-this-in-production-32-chars
POSTGRES_PASSWORD=your-secure-postgres-password-16-chars
REDIS_PASSWORD=your-secure-redis-password-16-chars
NEO4J_PASSWORD=your-secure-neo4j-password-16-chars
QDRANT_API_KEY=your-secure-qdrant-api-key-32-chars

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL - Primary Database
DATABASE_URL=postgresql://postgres:your-secure-postgres-password-16-chars@postgres:5432/multimodal_rag_prod

# Redis - Cache and Message Queue
REDIS_URL=redis://:your-secure-redis-password-16-chars@redis:6379/2

# Neo4j - Knowledge Graph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-secure-neo4j-password-16-chars

# Qdrant - Vector Database
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your-secure-qdrant-api-key-32-chars

# =============================================================================
# Application Configuration
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=WARNING

# CORS Configuration (update with your actual domain)
CORS_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# File Upload Configuration
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE=100MB
ENABLE_VIRUS_SCANNING=true
ENABLE_AI_PROCESSING=true

# =============================================================================
# External Service Configuration
# =============================================================================
# OpenAI - For GPT models
OPENAI_API_KEY=sk-your-openai-api-key-51-chars

# Anthropic - For Claude models
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-51-chars

# =============================================================================
# Monitoring and Observability
# =============================================================================
# Sentry - Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# DataDog - APM and Infrastructure Monitoring
DATADOG_API_KEY=your-datadog-api-key-32-chars
DD_ENV=production
DD_SERVICE=multimodal-rag-backend

# New Relic - APM (alternative to DataDog)
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key-40-chars

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_IMAGE=multimodal-rag-frontend:latest
REACT_APP_API_URL=https://api.yourdomain.com
REACT_APP_ENVIRONMENT=production
REACT_APP_ENABLE_DEBUG=false
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/frontend-project-id

# =============================================================================
# Backend Configuration
# =============================================================================
BACKEND_IMAGE=multimodal-rag-backend:latest

# =============================================================================
# Monitoring Services Authentication
# =============================================================================
# Grafana - Visualization Dashboard
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-secure-grafana-password-16-chars

# Flower - Celery Monitoring
FLOWER_USER=flower
FLOWER_PASSWORD=your-secure-flower-password-16-chars

# =============================================================================
# Email Configuration (for alerts)
# =============================================================================
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=your-smtp-password-16-chars

# =============================================================================
# SSL and Domain Configuration
# =============================================================================
# Update these with your actual domain and SSL configuration
DOMAIN_NAME=yourdomain.com
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# =============================================================================
# Additional Configuration
# =============================================================================
# Performance tuning
ENABLE_QUERY_CACHE=true
ENABLE_RESULT_CACHE=true
CACHE_TTL_SECONDS=3600

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST_SIZE=10

# Session management
SESSION_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS_PER_USER=5

# Backup configuration
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM UTC

# =============================================================================
# Build and Deployment Images
# =============================================================================
# These will be updated during the build process
FRONTEND_IMAGE=multimodal-rag-frontend:production-20251027
BACKEND_IMAGE=multimodal-rag-backend:production-20251027

# =============================================================================
# Notes for Production Deployment
# =============================================================================
# 1. Replace ALL password and API key values with strong, unique secrets
# 2. Update CORS_ORIGINS with your actual production domains
# 3. Configure proper SSL certificates and update DOMAIN_NAME
# 4. Set up monitoring and alerting configurations
# 5. Configure backup procedures and retention policies
# 6. Review and update resource limits in docker-compose.production.yml
# 7. Set up proper CI/CD pipelines with environment-specific secrets
# 8. Configure log aggregation and analysis systems
# 9. Perform load testing and capacity planning
# 10. Set up automated health checks and status pages