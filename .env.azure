# Azure OpenAI Environment Configuration for Multimodal Enterprise RAG System
# Copy this file to .env and update with your actual values

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DB_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://raguser:your_secure_postgres_password_here@postgres:5432/ragdb

REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://redis:6379/0

NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j

# ===========================================
# VECTOR DATABASE CONFIGURATION
# ===========================================
# For Qdrant Cloud (recommended for production)
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
QDRANT_URL=https://your-cluster-url.qdrant.io:6333

# For Local Development (comment out cloud config above)
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ===========================================
# AZURE OPENAI CONFIGURATION
# ===========================================
# Required: Get these from your Azure OpenAI resource
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Deployment names must match your Azure OpenAI deployments exactly
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-35-turbo

# ===========================================
# EMBEDDING PROVIDER CONFIGURATION
# ===========================================
# Options: sentence_transformers, azure_openai, auto
EMBEDDING_PROVIDER=azure_openai
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ===========================================
# ADDITIONAL AI SERVICES (Optional)
# ===========================================
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
SECRET_KEY=your_super_secret_application_key_change_this_in_production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ===========================================
# PERFORMANCE CONFIGURATION
# ===========================================
MAX_CONCURRENT_JOBS=10
WORKER_CONCURRENCY=8
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ACCESS_TOKEN_EXPIRE_MINUTES=30
BCRYPT_ROUNDS=12

# ===========================================
# FILE PROCESSING CONFIGURATION
# ===========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
MAX_CONCURRENT_UPLOADS=10

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=true

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_MULTIMODAL_PROCESSING=true
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_EVALUATION_METRICS=true
ENABLE_REAL_TIME_PROCESSING=true